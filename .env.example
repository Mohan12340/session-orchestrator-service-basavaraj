# Copy to .env for local development; do not commit .env

ECHOLIFE_PRIVATE_KEY_PATH=/absolute/path/to/private.pem
ECHOLIFE_PUBLIC_KEY_PATH=/absolute/path/to/public.pem
ECHO_MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ECHOLIFE_INTERNAL_SERVICE_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ECHOLIFE_JWT_ISSUER=http://identity-consent-service
IDENTITY_BASE_URL=http://localhost:8081
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_AUTO_CREATE_TABLE=true
SESSION_TTL_SECONDS=1800
AWS_REGION=ap-south-1
ECHOLIFE_CORS_ALLOWED_ORIGINS=http://localhost:3000
